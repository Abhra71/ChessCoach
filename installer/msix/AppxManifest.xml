<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package for Knightwise. Identity values come from Partner Center (Product identity). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">

  <Identity Name="Abhra71.Knightwise"
            Publisher="CN=D43461BE-8C8C-4E7A-A1D9-5573364016D1"
            Version="0.5.0.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Knightwise</DisplayName>
    <PublisherDisplayName>Abhra71</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A chess coach that sits behind you on chess.com: finds your mistakes, shows better moves and talks you through them.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Knightwise" Executable="ChessCoach.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Knightwise"
                          Description="Your chess coach on chess.com"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- starts with Windows (the player can switch it off in Settings > Apps > Startup) -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="KnightwiseStartup" Enabled="true" DisplayName="Knightwise" />
        </desktop:Extension>
        <!-- chesscoach:// links from notifications open the app -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="chesscoach">
            <uap:DisplayName>Knightwise</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
