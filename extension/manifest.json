{
  "manifest_version": 3,
  "name": "Knightwise",
  "version": "0.5.0",
  "description": "Your Knightwise coaches on chess.com, and arrows on the key moments of your finished games. Never active during a game.",
  "icons": {
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/game/live/*",
        "https://www.chess.com/game/daily/*",
        "https://www.chess.com/analysis/game/live/*",
        "https://www.chess.com/analysis/game/daily/*"
      ],
      "js": [
        "faces.js",
        "coach.js"
      ],
      "css": [
        "coach.css",
        "buddy.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "exclude_matches": [
        "https://www.chess.com/game/*",
        "https://www.chess.com/analysis/game/*",
        "https://www.chess.com/play/*"
      ],
      "js": [
        "faces.js",
        "buddy.js"
      ],
      "css": [
        "buddy.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Knightwise",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "permissions": [
    "offscreen",
    "storage",
    "alarms"
  ]
}
