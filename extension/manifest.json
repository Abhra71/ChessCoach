{
  "manifest_version": 3,
  "name": "Chess Coach",
  "version": "0.1.0",
  "description": "Shows the key moments of your finished chess.com games with arrows on the board. Never active during a live game.",
  "icons": { "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/game/live/*",
        "https://www.chess.com/game/daily/*",
        "https://www.chess.com/analysis/game/live/*",
        "https://www.chess.com/analysis/game/daily/*"
      ],
      "js": ["coach.js"],
      "css": ["coach.css"],
      "run_at": "document_idle"
    }
  ]
}
